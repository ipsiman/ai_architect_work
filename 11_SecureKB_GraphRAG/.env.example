# SecureKB — конфигурация окружения (шаблон).
# Скопируйте в .env и при необходимости переопределите значения.
# Секретов нет — только значения по умолчанию.

# HTTP-сервер API
SECUREKB_PORT=8000

# Qdrant (векторная БД)
SECUREKB_QDRANT_URL=http://localhost:6333

# Ingestion-конвейер (этап B)
SECUREKB_CORPUS_DIR=data/corpus
SECUREKB_GRAPH_DB_PATH=data/graph.db
SECUREKB_ENTITIES_PATH=data/entities.json
SECUREKB_EMBEDDING_MODEL=intfloat/multilingual-e5-small
SECUREKB_QDRANT_COLLECTION=securekb_chunks
SECUREKB_CHUNK_SIZE_TOKENS=500
SECUREKB_CHUNK_OVERLAP_TOKENS=50

# OpenTelemetry (OTLP → Jaeger)
SECUREKB_OTEL_ENABLED=true
SECUREKB_OTEL_ENDPOINT=http://localhost:4318

# Логирование (DEBUG / INFO / WARNING / ERROR)
SECUREKB_LOG_LEVEL=INFO

# Guardrails + аудит (этап D)
SECUREKB_GUARD_INJECTION_ENABLED=true   # InjectionGuard на входе (prompt-injection)
SECUREKB_GUARD_INPUT_PII_ENABLED=true   # PII-маскировка вопроса до ретрива
SECUREKB_GUARD_OUTPUT_ENABLED=true      # санитизация ответа LLM (PII/[N]/SECRET)
SECUREKB_AUDIT_ENABLED=true             # журнал audit_log в data/graph.db
